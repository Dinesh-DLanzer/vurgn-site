---
// Renders a link when given href, otherwise a <button>. States live in global.css (.btn).
import type { HTMLAttributes } from 'astro/types';

type Props = {
  variant?: 'primary' | 'secondary' | 'text' | 'ink';
  href?: string;
  arrow?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'class'>;

const { variant = 'primary', href, arrow = false, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag href={href} class:list={['btn', `btn--${variant}`, className]} {...rest}>
  <slot />
  {arrow && (
    <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 8h11M9 3.5 13.5 8 9 12.5" />
    </svg>
  )}
</Tag>
