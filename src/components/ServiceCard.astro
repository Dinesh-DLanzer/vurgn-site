---
// One service as a filled tile; the whole tile is the link (stretched from the title).
import type { Service } from '../content/home';

interface Props {
  service: Service;
  field: 'paper' | 'wash' | 'primary' | 'deep';
  size?: 'large' | 'small';
  index?: number;
}
const { service, field, size = 'small', index = 0 } = Astro.props;
---

<article class:list={['service', `service--${size}`]} data-field={field} data-reveal style={`--i:${index % 3}`}>
  <h3 class:list={[size === 'large' ? 'head' : 'lead', 'service__title']}>
    <a href={service.href} class="service__link"><span>{service.title}</span></a>
  </h3>
  <p class="service__outcome">{service.outcome}</p>
  <svg class="service__arrow" viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14 34 34 14M17 14h17v17" />
  </svg>
</article>

<style>
  .service {
    position: relative;
    display: flex; flex-direction: column; gap: var(--space-3);
    padding: var(--space-6);
    border-radius: var(--radius-surface);
    transition: background-color var(--t-hover) ease, color var(--t-hover) ease;
  }
  .service__title { font-weight: var(--weight-display); max-width: 18ch; }
  .service--large .service__title { max-width: 12ch; }
  .service__link { color: inherit; text-decoration: none; }
  .service__link::after { content: ''; position: absolute; inset: 0; }
  .service__outcome { max-width: 38ch; }
  .service--large .service__outcome { font-size: var(--step-lead); line-height: 1.35; max-width: 26ch; }
  .service__arrow { width: 2.5rem; height: 2.5rem; margin-top: auto; align-self: flex-end; transition: transform var(--t-hover) var(--ease-out); }
  .service--large .service__arrow { width: 3.5rem; height: 3.5rem; }

  .service:has(.service__link:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }
  .service__link:focus-visible { outline: none; }
  .service:active { transform: scale(0.99); }
  @media (hover: hover) and (pointer: fine) {
    .service:hover { background: var(--ink); color: var(--n-0); }
    .service:hover .service__arrow { transform: translate(4px, -4px); }
  }
</style>
