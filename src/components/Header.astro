---
import { Image } from 'astro:assets';
import logo from '../assets/vurgn-logo.png';
import MobileNav from './MobileNav';
import { nav, consultation, contact, home, industries } from '../content/home';

const panels = {
  services: {
    lead: 'Four services that work best together.',
    items: home.services.map((s) => ({ label: s.title, href: s.href, line: s.outcome })),
    all: { label: 'All services', href: '/services' },
  },
  industries: {
    lead: 'The sectors we know best.',
    items: industries,
    all: { label: 'All industries', href: '/industries' },
  },
};
---

<header class="header">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="header__bar">
    <a href={import.meta.env.BASE_URL} class="header__brand">
      <Image src={logo} alt="Vurgn home" width={116} height={41} densities={[1.5, 2]} loading="eager" format="webp" class="header__logo" />
    </a>
    <nav class="header__nav" aria-label="Main">
      <ul role="list" class="nav">
        {nav.map((item) => {
          const panel = item.menu && panels[item.menu];
          return (
            <li class="nav__item" data-menu={item.menu}>
              <a class="nav__link" href={item.href}>{item.label}</a>
              {panel && (
                <>
                  <button type="button" class="nav__toggle" aria-expanded="false" aria-controls={`menu-${item.menu}`}>
                    <span class="sr-only">{item.label} menu</span>
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m3.5 6 4.5 4.5L12.5 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </button>
                  <div class="mega" id={`menu-${item.menu}`}>
                    <div class:list={['mega__inner', `mega__inner--${item.menu}`]}>
                      <p class="mega__lead">{panel.lead} <a class="link" href={panel.all.href}>{panel.all.label}</a></p>
                      <ul role="list" class="mega__grid">
                        {panel.items.map((entry) => (
                          <li>
                            <a class="mega__card" href={entry.href}>
                              <span class="mega__title">{entry.label}</span>
                              <span class="mega__line">{entry.line}</span>
                            </a>
                          </li>
                        ))}
                        <li class="mega__aside" data-field="deep">
                          <p>Not sure where to start? We look at how you show up today and suggest one first step.</p>
                          <a class="btn btn--primary" href={consultation.href}>{consultation.label}</a>
                          <a class="link" href={home.diagnostic.href}>Free AI visibility check</a>
                        </li>
                      </ul>
                    </div>
                  </div>
                </>
              )}
            </li>
          );
        })}
      </ul>
    </nav>
    <a class="btn btn--primary header__cta" href={consultation.href}>
      <span class="header__cta-long">{consultation.label}</span>
      <span class="header__cta-short" aria-hidden="true">Free consultation</span>
    </a>
    {/* Island: the drawer needs open/close state, focus handling and Escape. client:visible because the
        Menu button is display:none from 1024px, so desktop never downloads React for it. */}
    <MobileNav client:visible links={nav} cta={consultation} contact={contact} />
  </div>
</header>

<script>
  // Mega menu. Hover opens a panel in CSS; the toggle buttons give keyboard and touch users the same panels,
  // and Escape closes them (WCAG 1.4.13). Plain script, so desktop still loads no framework.
  const items = [...document.querySelectorAll<HTMLElement>('.nav__item[data-menu]')];
  const toggleOf = (item: HTMLElement) => item.querySelector<HTMLButtonElement>('.nav__toggle')!;
  const set = (item: HTMLElement, open: boolean) => {
    item.classList.toggle('is-open', open);
    toggleOf(item).setAttribute('aria-expanded', String(open));
  };
  for (const item of items) {
    toggleOf(item).addEventListener('click', () => {
      const open = !item.classList.contains('is-open');
      items.forEach((other) => other !== item && set(other, false));
      item.classList.remove('is-dismissed');
      set(item, open);
    });
    item.addEventListener('focusout', (e) => { if (!item.contains(e.relatedTarget as Node | null)) set(item, false); });
    item.addEventListener('mouseleave', () => item.classList.remove('is-dismissed'));
  }
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const item of items) {
      if (item.matches(':hover')) item.classList.add('is-dismissed');
      if (item.classList.contains('is-open')) { set(item, false); toggleOf(item).focus(); }
    }
  });
  document.addEventListener('click', (e) => { for (const item of items) if (!item.contains(e.target as Node)) set(item, false); });
</script>

<style>
  .header { position: sticky; top: 0; z-index: 20; background: var(--paper); }
  .header__bar {
    display: flex; align-items: center; gap: var(--space-2);
    height: var(--header-h); padding-inline: var(--gutter) var(--space-2);
    max-width: 90rem; margin-inline: auto;
  }
  .header__brand { display: flex; align-items: center; min-height: var(--target-min); margin-right: auto; }
  .header__logo { width: 5.5rem; height: auto; }
  .header__nav { display: none; }
  .header__cta { min-height: var(--target-min); padding-inline: var(--space-4); font-size: var(--step-small); }
  .header__cta-long { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @media (min-width: 30em) {
    .header__cta { font-size: var(--step-body); padding-inline: var(--space-5); }
    .header__cta-long { position: static; width: auto; height: auto; overflow: visible; clip-path: none; }
    .header__cta-short { display: none; }
  }
  @media (min-width: 64em) {
    .header__bar { gap: 0; padding-inline: 0 var(--gutter); }
    .header__brand { margin-right: 0; padding-inline: var(--gutter) var(--space-8); }
    .header__logo { width: 7.25rem; }
    .header__nav { display: flex; align-self: stretch; margin-right: auto; background: var(--brand-wash); }
    .nav { display: flex; align-items: stretch; padding-inline: var(--space-3); }
    .nav__item { display: flex; align-items: center; }
    .nav__link {
      display: flex; align-items: center; height: 100%; padding-inline: var(--space-3);
      color: var(--ink); text-decoration: none;
      text-decoration-thickness: 0.08em; text-underline-offset: 0.3em;
    }
    .nav__item[data-menu] .nav__link { padding-right: var(--space-1); }
    .nav__link:hover { text-decoration: underline; }
    .nav__link:focus-visible { outline-offset: -3px; }
    .nav__toggle {
      display: grid; place-items: center; width: 1.75rem; height: 1.75rem; margin-right: var(--space-2);
      border: 0; border-radius: var(--radius-control); background: none; color: var(--ink);
      transition: background-color var(--t-hover) ease;
    }
    .nav__toggle:hover { background: var(--brand-lavender); }
    .nav__toggle:active { transform: scale(0.94); }
    .nav__toggle svg { transition: transform var(--t-ui) var(--ease-out); }

    /* The panel hangs from the header's lower edge, full width. Opening waits 80ms so a pointer crossing the bar does not flash panels. */
    .mega {
      position: absolute; left: 0; right: 0; top: 100%;
      background: var(--brand-wash); box-shadow: var(--shadow-float); /* taste-skill-ignore: open menu floats */
      visibility: hidden; opacity: 0; translate: 0 -0.5rem;
      transition: opacity 140ms ease, translate 200ms var(--ease-out), visibility 0s linear 140ms;
    }
    .nav__item:hover:not(.is-dismissed) > .mega, .nav__item.is-open > .mega {
      visibility: visible; opacity: 1; translate: 0;
      transition: opacity 180ms ease 80ms, translate 240ms var(--ease-out) 80ms, visibility 0s linear 80ms;
    }
    .nav__item:hover:not(.is-dismissed) .nav__toggle svg, .nav__item.is-open .nav__toggle svg { transform: rotate(180deg); }
    .nav__item:hover:not(.is-dismissed) > .nav__link, .nav__item.is-open > .nav__link { text-decoration: underline; }

    .mega__inner { max-width: 90rem; margin-inline: auto; padding: var(--space-6) var(--gutter) var(--space-8); }
    .mega__lead { margin-bottom: var(--space-4); color: var(--ink); }
    .mega__lead .link { margin-left: var(--space-2); }
    .mega__grid { display: grid; gap: var(--tile-gap); grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(15rem, 1.15fr); }
    .mega__inner--industries .mega__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .mega__card {
      display: flex; flex-direction: column; gap: var(--space-2); height: 100%; min-height: 8.5rem;
      padding: var(--space-5); background: var(--paper); color: var(--ink); text-decoration: none;
      transition: background-color var(--t-hover) ease, color var(--t-hover) ease;
    }
    .mega__card:hover { background: var(--brand-primary); color: var(--n-0); }
    .mega__card:active { transform: scale(0.99); }
    .mega__card:focus-visible { outline-offset: -3px; }
    .mega__title { font-size: var(--step-lead); font-weight: var(--weight-display); line-height: 1.15; letter-spacing: -0.01em; }
    .mega__line { font-size: var(--step-small); line-height: 1.4; }
    .mega__aside { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); padding: var(--space-5); }
    .mega__aside p { font-size: var(--step-small); }
  }
  @media (min-width: 80em) { .nav { padding-inline: var(--space-4) var(--space-6); } .nav__link { padding-inline: var(--space-4); } }
</style>

<!-- The menu island renders outside Astro's scoping, so its styles are global. -->
<style is:global>
  .menu-btn {
    display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: var(--target-min); min-width: var(--target-min); padding-inline: var(--space-3);
    background: none; border: 0; border-radius: var(--radius-control); color: var(--ink); font-weight: var(--weight-strong);
    transition: background-color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }
  .menu-btn:hover { background: var(--brand-wash); }
  .menu-btn:active { transform: scale(0.96); }
  @media (min-width: 64em) { .menu-btn { display: none; } }

  .drawer {
    margin: 0 0 0 auto; width: min(24rem, 100% - 3rem); max-width: none; height: 100dvh; max-height: none;
    border: 0; padding: 0; background: var(--paper); color: var(--ink); box-shadow: var(--shadow-float); /* taste-skill-ignore: modal drawer floats */
  }
  .drawer::backdrop { background: rgb(13 20 26 / 0.55); }
  .drawer__inner { display: flex; flex-direction: column; gap: var(--space-8); min-height: 100%; padding: var(--space-4) var(--space-6) var(--space-10); }
  .drawer__close {
    align-self: flex-end; display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: var(--target-min); padding-inline: var(--space-3); background: var(--brand-wash);
    border: 0; border-radius: var(--radius-control); font-weight: var(--weight-strong);
  }
  .drawer__close:active { transform: scale(0.96); }
  .drawer__links a {
    display: block; padding-block: var(--space-2);
    font-size: var(--step-head); font-weight: var(--weight-display); letter-spacing: -0.03em; line-height: 1.1;
    color: var(--ink); text-decoration: none;
  }
  .drawer__links a:hover { color: var(--brand-primary); }
  .drawer__cta { align-self: flex-start; }
  .drawer__contact { display: grid; gap: var(--space-2); margin-top: auto; }
  .drawer__contact a { display: inline-flex; align-items: center; min-height: var(--target-min); }
  @media (prefers-reduced-motion: no-preference) {
    .drawer[open] { animation: drawer-in var(--t-ui) var(--ease-out); }
    .drawer[open]::backdrop { animation: fade-in var(--t-ui) ease; }
  }
  @keyframes drawer-in { from { transform: translateX(100%); } }
  @keyframes fade-in { from { opacity: 0; } }
</style>
